---
import { siteConfig, type Theme } from "@/web/site";

/**
 * 테마 선택 버튼
 *
 * site.ts에 정의된 테마 설정을 사용합니다.
 */
const themeConfig = siteConfig.theme;

const themeOptions: {
    value: Theme;
    label: string;
    emoji: string;
}[] = [
    {
        value: "general",
        label: "기본 테마",
        emoji: "⚙️"
    },
    {
        value: "dog",
        label: "강아지 테마",
        emoji: "🐶"
    },
    {
        value: "cat",
        label: "고양이 테마",
        emoji: "🐱"
    }
];

/**
 * 설정에서 활성화된 테마만 버튼으로 표시합니다.
 */
const visibleThemeOptions = themeOptions.filter((option) =>
    themeConfig.themes.includes(option.value)
);
---

<div class="theme-toggle-container" role="group" aria-label="테마 선택">
    {visibleThemeOptions.map((option) => (
        <button
            type="button"
            class="toggle-btn"
            data-theme-toggle
            data-theme-value={option.value}
            aria-pressed="false"
            aria-label={option.label}
            title={option.label}
        >
            <span class="emoji" aria-hidden="true">
                {option.emoji}
            </span>
        </button>
    ))}
</div>

<script>
    import { siteConfig, type Theme } from "@/web/site";

    /**
     * 1. 사이트 테마 설정
     *
     * 테마 이름과 저장 키는 site.ts에서 가져옵니다.
     */
    const themeConfig = siteConfig.theme;

    const {
        themes,
        defaultTheme,
        attribute,
        cookieKey,
        storageKey,
        metaColor
    } = themeConfig;

    /**
     * 2. 테마 유효성 검사
     */
    function isTheme(value: string | null | undefined): value is Theme {
        return typeof value === "string" && themes.includes(value as Theme);
    }

    /**
     * 3. 쿠키 저장
     */
    function saveThemeCookie(theme: Theme) {
        try {
            const secure =
                window.location.protocol === "https:" ? "; Secure" : "";

            document.cookie =
                `${encodeURIComponent(cookieKey)}=` +
                `${encodeURIComponent(theme)}; ` +
                `Path=/; Max-Age=31536000; SameSite=Lax${secure}`;
        } catch {
            console.warn("테마 쿠키를 저장하지 못했습니다.");
        }
    }

    /**
     * 4. 테마 버튼 상태 갱신
     */
    function updateToggleButtons(theme: Theme) {
        const buttons = document.querySelectorAll<HTMLButtonElement>(
            "[data-theme-toggle]"
        );

        buttons.forEach((button) => {
            const isActive = button.dataset.themeValue === theme;

            button.classList.toggle("active", isActive);

            button.setAttribute("aria-pressed", String(isActive));
        });
    }

    /**
     * 5. 브라우저 상단 색상 변경
     */
    function updateMetaColor(theme: Theme) {
        const metaTag = document.getElementById("theme-color-meta");

        const color = metaColor[theme];

        if (metaTag && color) {
            metaTag.setAttribute("content", color);
        }
    }

    /**
     * 6. 테마 적용
     *
     * HTML 속성, 저장소, 브라우저 메타 색상을
     * 한 번에 변경합니다.
     */
    function applyTheme(theme: Theme) {
        if (!isTheme(theme)) return;

        // HTML 테마 변경
        document.documentElement.setAttribute(attribute, theme);

        // localStorage 저장
        try {
            localStorage.setItem(storageKey, theme);
        } catch {
            console.warn("테마 설정을 localStorage에 저장하지 못했습니다.");
        }

        // 쿠키 저장
        saveThemeCookie(theme);

        // 모바일 브라우저 색상 변경
        updateMetaColor(theme);

        // 버튼 선택 상태 갱신
        updateToggleButtons(theme);
    }

    /**
     * 7. 현재 테마에 맞는 버튼 상태 표시
     *
     * 실제 HTML에 적용된 테마를 기준으로 합니다.
     */
    function syncToggleButtons() {
        const currentTheme = document.documentElement.getAttribute(attribute);

        const theme = isTheme(currentTheme) ? currentTheme : defaultTheme;

        updateToggleButtons(theme);
    }

    /**
     * 8. 이벤트 위임
     *
     * 버튼마다 이벤트를 등록하지 않고
     * document에서 클릭을 한 번에 처리합니다.
     */
    function handleThemeClick(event: MouseEvent) {
        if (!(event.target instanceof Element)) return;

        const button = event.target.closest<HTMLButtonElement>(
            "[data-theme-toggle]"
        );

        if (!button) return;

        const targetTheme = button.dataset.themeValue;

        if (!isTheme(targetTheme)) return;

        applyTheme(targetTheme);
    }

    /**
     * 9. 이벤트 등록
     *
     * Astro 페이지 이동 후에도 버튼 상태를 동기화합니다.
     */
    document.addEventListener("click", handleThemeClick);

    document.addEventListener("astro:page-load", syncToggleButtons);

    // 최초 실행
    syncToggleButtons();
</script>

<style>
    .theme-toggle-container {
        position: relative;
        z-index: 10;

        display: flex;
        align-items: center;
        gap: 0.375rem;

        width: fit-content;
        padding: 0.25rem;

        border: 1px solid var(--theme-toggle-border, rgba(255, 255, 255, 0.4));

        border-radius: 9999px;

        background-color: var(--color-base-200, #f1f1f1);

        box-shadow: 0 1px 2px rgb(0 0 0 / 5%);

        backdrop-filter: blur(12px);

        transition: background-color 250ms ease;
    }

    .toggle-btn {
        display: flex;
        align-items: center;
        justify-content: center;

        flex: 0 0 auto;

        width: 2.375rem;
        height: 2.375rem;
        padding: 0;

        border: 0;
        border-radius: 9999px;

        background-color: transparent;
        color: inherit;

        cursor: pointer;

        transition:
            background-color 250ms ease,
            box-shadow 250ms ease,
            transform 250ms ease;
    }

    .toggle-btn:hover {
        background-color: var(--theme-toggle-hover, rgb(128 128 128 / 12%));
    }

    .toggle-btn:active {
        transform: scale(0.96);
    }

    .toggle-btn:focus-visible {
        outline: 2px solid var(--color-primary, #64748b);
        outline-offset: 3px;
    }

    .emoji {
        display: inline-block;

        font-size: 1.125rem;
        line-height: 1;

        opacity: 0.55;
        filter: grayscale(40%);

        transition:
            filter 250ms ease,
            opacity 250ms ease;
    }

    .toggle-btn.active {
        background-color: var(--theme-bg, var(--color-base-100, #fff));

        box-shadow:
            0 4px 6px -1px rgb(0 0 0 / 10%),
            0 2px 4px -1px rgb(0 0 0 / 6%);

        transform: scale(1.05);
    }

    .toggle-btn.active .emoji {
        opacity: 1;
        filter: grayscale(0%);
    }

    @media (min-width: 768px) {
        .toggle-btn {
            width: 2.25rem;
            height: 2.25rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .theme-toggle-container,
        .toggle-btn,
        .emoji {
            transition: none;
        }
    }
</style>
