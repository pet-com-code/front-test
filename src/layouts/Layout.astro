---
import "@/web/styles/global.css"; // 전체 사이트에 적용되는 스타일
import { siteConfig, themeEnum, type Theme } from "@/web/site"; // 사이트 설정, 테마의 TypeScript 타입

interface Props {
    title?: string;
    description?: string;
    theme?: Theme;
    ogImage?: string; //  1200 × 630 px (비율 1.91:1), 페이지의 대표 이미지, 상품 이미지
}

const {
    title,
    description,
    theme: propTheme,
    ogImage: propOgImage
} = Astro.props;

// const propTheme = Astro.props.theme;
// const propOgImage = Astro.props.ogImage;

// 왜 이름을 변경했을까요?
// 1. `ogImage`라는 이름은 페이지에서 전달한 원래 값입니다.
// 2. 뒤에서 `ogImage`라는 이름을 실제 최종 이미지 URL 변수로 다시 사용하기 때문입니다.
// 3. 따라서 페이지에서 전달한 원래 값과 최종 계산한 값을 구분하기 위해 이름을 바꾼 것입니다.

// 기본 페이지 메타데이터 설정
const pageTitle = title ? `${title} | ${siteConfig.brand}` : siteConfig.brand;
const ogTitle = title || siteConfig.brand; // 소셜미디어에 공유할 때 사용하는 제목
const finalDescription = description || siteConfig.description;

// Canonical 및 OG URL 경로 생성
const origin = Astro.site?.origin ?? Astro.url.origin; //Astro 설정 파일에서 지정한 사이트 주소
// "??"는 Nullish Coalescing 연산자, 앞의 값이 null 또는 undefined일 때 뒤의 값을 사용합니다.
const canonicalUrl = new URL(Astro.url.pathname, origin).href; // 현재 페이지의 대표 URL 생성 (https://pet.com/dog/find)
const ogImage = new URL(propOgImage || siteConfig.defaultImage, origin).href; // 소셜미디어에 공유할 이미지의 최종 주소

/**
 * 서버에서 테마 유효성 검사
 *
 * TypeScript의 타입 단언(as Theme)은 실제 값을 검사하지 않습니다.
 * 따라서 Zod의 safeParse()를 사용합니다.
 */
const themeConfig = siteConfig.theme;
const cookieThemeValue = Astro.cookies.get(themeConfig.cookieKey)?.value;
const cookieThemeResult = themeEnum.safeParse(cookieThemeValue);
const propThemeResult = themeEnum.safeParse(propTheme);

/**
 * 페이지에서 전달한 테마가 가장 높은 우선순위를 가집니다.
 * 그다음 쿠키, 마지막으로 기본 테마를 사용합니다.
 *
 * 이번에는 다음 순서로 테마를 결정합니다.
 * 1. 페이지에서 명시적으로 전달한 theme 속성
 * 2. 브라우저 쿠키에 저장된 테마
 * 3. localStorage에 저장된 테마
 * 4. 사이트 기본 테마
 *
 * 서버에서는 localStorage에 접근할 수 없으므로 서버 렌더링 시에는 1, 2, 4번을 사용
 * 브라우저가 실행되면 3번까지 확인하여 최종 테마를 동기화합니다.
 */

const forcedTheme = propThemeResult.success ? propThemeResult.data : null;

const cookieTheme = cookieThemeResult.success ? cookieThemeResult.data : null;

const initialTheme: Theme =
    forcedTheme ?? cookieTheme ?? themeConfig.defaultTheme;

/**
 * 테마별 브라우저 상단 색상
 */
const currentMetaColor = themeConfig.metaColor[initialTheme];

/**
 * 5. 브라우저 초기화 스크립트에 전달할 설정
 *
 * JSON 문자열로 전달하여 클라이언트에서 동일한 설정을 사용합니다.
 */
const themeConfigJson = JSON.stringify({
    cookieKey: themeConfig.cookieKey, // 쿠키에 저장할 키 이름, theme
    storageKey: themeConfig.storageKey, // 로컬스토리지에 저장할 키 이름, theme
    defaultTheme: themeConfig.defaultTheme, // 기본 테마, general
    attribute: themeConfig.attribute, // HTML attribute 이름, data-theme, 구조 분해 할당에서 기본값을 지정
    themes: themeConfig.themes,
    metaColor: themeConfig.metaColor, // 모바일 브라우저 상단바 색상, 테마별 색상 객체
    initialTheme,
    forcedTheme
}).replace(/</g, "\\u003c");

// {
//   "cookieKey": "theme",
//   "storageKey": "theme",
//   "defaultTheme": "general",
//   "attribute": "data-theme",
//   "metaColor": {
//     "general": "#7f8c8d",
//     "dog": "#4a90e2",
//     "cat": "#ffa6c9"
//   }
// }
---

<!doctype html>
<html lang="ko" data-theme={initialTheme}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <!-- 현재 테마에 해당하는 색상을 모바일 브라우저에 알려줍니다. -->
        <meta
            name="theme-color"
            content={currentMetaColor}
            id="theme-color-meta"
        />

        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="shortcut icon" href="/favicon.ico" />

        <!-- Pretendard Variable Dynamic Subset -->
        <!-- preconnect - 외부 서버 연결 사전 준비 -->
        <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
        <link
            rel="stylesheet"
            crossorigin
            href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.css"
        />

        <!-- SEO 및 표준 Canonical URL, 검색엔진에 페이지 정보를 전달 -->

        <!-- canonical - 검색엔진 대표 URL -->
        <link rel="canonical" href={canonicalUrl} />
        <title>{pageTitle}</title>
        <meta name="description" content={finalDescription} />
        <meta name="author" content={siteConfig.author} />
        <!-- keywords - 검색 키워드 -->
        {siteConfig.keywords.length > 0 && (
            <meta name="keywords" content={siteConfig.keywords.join(", ")} />
        )}
        <!-- robots - 검색엔진 크롤링 지침 -->
        <meta name="robots" content="index, follow" />

        <!-- 오픈 그래프 (OG) & 트위터 메타 태그 -->
        <!-- 사이트 주소를 카카오톡, 페이스북, X 등의 서비스에 공유했을 때 나타나는 정보 -->
        <!-- 강아지 찾기 페이지를 카카오톡으로 공유한다면 페이지 제목, 설명, 이미지가 미리보기로 표시 -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={siteConfig.brand} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:title" content={ogTitle} />
        <meta property="og:description" content={finalDescription} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:alt" content={pageTitle} />
        <meta property="og:locale" content={siteConfig.social.locale} />

        <!--
            | `og:type`        | 콘텐츠 종류      |
            | `og:site_name`   | 사이트 이름      |
            | `og:url`         | 페이지 대표 주소 |
            | `og:title`       | 공유 제목        |
            | `og:description` | 공유 설명        |
            | `og:image`       | 공유 이미지      |
            | `og:image:alt`   | 공유 이미지 설명 |
            | `og:locale`      | 언어 및 지역     | 
        -->

        <!-- Twitter 카드 설정 -->
        <meta name="twitter:card" content="summary_large_image" />
        {siteConfig.social.twitter && (
            <meta name="twitter:site" content={siteConfig.social.twitter} />
        )}
        <meta name="twitter:title" content={ogTitle} />
        <meta name="twitter:description" content={finalDescription} />
        <meta name="twitter:image" content={ogImage} />

        <!--
            클라이언트 테마 동기화 스크립트 (FOUC 방지 및 브라우저 헤더 동기화)

            테마 초기화, 테마 초기화는 Layout에서만 담당합니다.
            이 스크립트는 HTML을 브라우저가 표시하기 전에 실행되도록 head 안에 배치합니다.
        -->
        <script is:inline define:vars={{ themeConfigRaw: themeConfigJson }}>
            // ① is:inline
            // Astro가 일반적인 스크립트 번들링 처리 대신 작성한 JavaScript를 HTML에 인라인으로 넣도록 합니다.
            // ② define:vars
            // Astro 서버에서 만든 변수를 스크립트에 전달합니다.
            // themeConfigJson로 전달된 값을 themeConfigRaw라는 이름으로 스크립트 내부에서 사용할 수 있습니다.
            (function () {
                // 즉시 실행 함수(IIFE)
                try {
                    const config = JSON.parse(themeConfigRaw);

                    const {
                        cookieKey,
                        storageKey,
                        defaultTheme,
                        attribute,
                        themes,
                        metaColor,
                        initialTheme,
                        forcedTheme
                    } = config;

                    // JSON 문자열로 만들었던 데이터를 다시 JavaScript 객체로 변환
                    // cookieKey = "theme"; storageKey = "theme"; defaultTheme = "general"; attribute = "data-theme";

                    const isValidTheme = (value) =>
                        typeof value === "string" && themes.includes(value);

                    /**
                     * 쿠키 읽기
                     */
                    function readCookie(name) {
                        try {
                            const prefix = encodeURIComponent(name) + "=";

                            const item = document.cookie
                                .split(";")
                                .map((value) => value.trim())
                                .find((value) => value.startsWith(prefix));

                            if (!item) return null;

                            return decodeURIComponent(
                                item.slice(prefix.length)
                            );
                        } catch {
                            return null;
                        }
                    }

                    /**
                     * localStorage 읽기
                     */
                    function readStorage() {
                        try {
                            return localStorage.getItem(storageKey);
                        } catch {
                            return null;
                        }
                    }

                    /**
                     * 쿠키 저장
                     */
                    function writeCookie(theme) {
                        try {
                            const secure =
                                location.protocol === "https:"
                                    ? "; Secure"
                                    : "";

                            document.cookie =
                                encodeURIComponent(cookieKey) +
                                "=" +
                                encodeURIComponent(theme) +
                                "; Path=/; Max-Age=31536000; SameSite=Lax" +
                                secure;
                        } catch {
                            // 쿠키 저장이 불가능한 환경에서는 무시합니다.
                        }
                    }

                    /**
                     * 최종 테마 결정
                     *
                     * 페이지 지정 > 쿠키 > localStorage > 서버 초기값
                     */
                    const cookieTheme = readCookie(cookieKey);
                    const storageTheme = readStorage();

                    const candidates = [
                        forcedTheme,
                        cookieTheme,
                        storageTheme,
                        initialTheme,
                        defaultTheme
                    ];

                    const currentTheme =
                        candidates.find(isValidTheme) || themes[0];

                    /**
                     * HTML 테마 적용
                     */
                    document.documentElement.setAttribute(
                        attribute,
                        currentTheme
                    );

                    /**
                     * 모바일 브라우저 상단 색상 변경
                     */
                    const metaTag = document.getElementById("theme-color-meta");

                    if (metaTag && metaColor[currentTheme]) {
                        metaTag.setAttribute(
                            "content",
                            metaColor[currentTheme]
                        );
                    }

                    /**
                     * 저장소 동기화
                     */
                    try {
                        localStorage.setItem(storageKey, currentTheme);
                    } catch {
                        // localStorage 저장 실패 시 무시합니다.
                    }

                    writeCookie(currentTheme);
                } catch (e) {
                    console.error("테마 초기화 중 오류가 발생했습니다.", error);
                }

                // // 1. 쿠키 및 로컬스토리지에서 기존 테마 값 파싱(읽기)
                // const cookieMatch = document.cookie.match(
                //     new RegExp("(?:^|; )" + cookieKey + "=([^;]*)")
                // ); // 브라우저의 쿠키 문자열에서 "theme"이라는 이름을 가진 쿠키를 찾습니다.
                // const cookieTheme = cookieMatch ? cookieMatch[1] : null; // 쿠키 검색에 성공했다면 검색 결과의 첫 번째 캡처 그룹을 가져옵니다.
                // const storageTheme = localStorage.getItem(storageKey); // LocalStorage에서 테마 읽기

                // // 2. 우선순위: 쿠키 > 로컬스토리지 > 기본값
                // const currentTheme =
                //     cookieTheme || storageTheme || defaultTheme;

                // // 3. HTML attribute 동기화 (깜빡임 차단)
                // document.documentElement.setAttribute(
                //     attribute,
                //     currentTheme
                // ); // 실제 HTML 문서에 테마를 적용, attribute = "data-theme"; currentTheme = "dog";

                // // 4. 모바일 브라우저 상단바 색상 동기화, meta 테그 변경
                // const metaTag = document.getElementById("theme-color-meta");
                // if (metaTag && metaColor && metaColor[currentTheme]) {
                //     metaTag.setAttribute(
                //         "content",
                //         metaColor[currentTheme]
                //     );
                // }
                // // 예를 들어 강아지 테마라면:
                // // <meta name="theme-color" content="#4a90e2" id="theme-color-meta" />

                // // 5. 로컬스토리지 동기화
                // // 쿠키에 저장된 테마와 LocalStorage에 저장된 테마를 일치시키는 역할
                // if (storageTheme !== currentTheme && cookieTheme) {
                //     localStorage.setItem(storageKey, currentTheme);
                // }

                // // 여기서 `!==`는 값이 다르다는 의미입니다.
                // // 그리고 `&&`는 두 조건이 모두 참이어야 한다는 뜻입니다.
                // // 즉 다음 두 조건을 모두 만족해야 실행합니다.
                // // - LocalStorage와 현재 테마가 다르다.
                // // - 쿠키가 존재한다.
            })();
        </script>
        <!-- 
            | 변수                 | 기능                   |
            | ------------------ | -------------------- |
            | `Props`            | Layout 입력값의 타입       |
            | `title`            | 페이지 제목               |
            | `description`      | 페이지 설명               |
            | `ogImage`          | 페이지 대표 이미지 입력        |
            | `theme`            | 페이지 테마 입력            |
            | `propOgImage`      | 전달된 대표 이미지           |
            | `propTheme`        | 전달된 테마               |
            | `pageTitle`        | 최종 브라우저 제목           |
            | `ogTitle`          | 최종 공유 제목             |
            | `finalDescription` | 최종 페이지 설명            |
            | `origin`           | 사이트 기본 주소            |
            | `canonicalUrl`     | 페이지 대표 URL           |
            | `ogImage`          | 최종 대표 이미지 URL        |
            | `cookieKey`        | 쿠키 이름                |
            | `storageKey`       | LocalStorage 키       |
            | `defaultTheme`     | 기본 테마                |
            | `attribute`        | HTML 테마 속성           |
            | `metaColor`        | 테마별 브라우저 색상          |
            | `savedThemeCookie` | 서버에서 읽은 테마           |
            | `initialTheme`     | 서버에서 결정한 테마          |
            | `currentMetaColor` | 서버에서 결정한 브라우저 색상     |
            | `themeConfigJson`  | 브라우저 전달용 JSON        |
            | `cookieMatch`      | 쿠키 검색 결과             |
            | `cookieTheme`      | 브라우저 쿠키 테마           |
            | `storageTheme`     | LocalStorage 테마      |
            | `currentTheme`     | 브라우저에서 결정한 테마        |
            | `metaTag`          | theme-color 메타 태그 요소 |
            | `e`                | 예외 객체                |
        -->
    </head>
    <body>
        <div class="view-page">
            <slot />
        </div>
    </body>
</html>

<style>
    body {
        display: flex;
        flex-direction: column; /* 세로 방향으로 배치 */
        min-height: 100dvh; /* 화면 높이 이상 확보 */
    }

    .view-page {
        max-width: var(--main-width, 1200px); /* 최대 너비 1200px */
        margin: 0 auto; /* 좌우 가운데 정렬 */
        padding: 0 1rem; /* 좌우 내부 여백 */
        min-height: 100dvh; /* 최소 화면 높이 */
        width: 100%; /* 부모 너비 전체 사용 */
    }

    @media (min-width: 1200px) {
        /*
            화면 너비가 1200px 이상일 때 좌우 내부 여백을 제거합니다.
            즉, 모바일이나 작은 화면에서는 좌우 여백을 확보하고 큰 화면에서는
            불필요한 여백을 제거하는 반응형 처리입니다.
        */
        .view-page {
            padding: 0;
        }
    }
</style>
