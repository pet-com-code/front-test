---
// src/layouts/LayoutB.astro
// [방식 B] 항상 data-theme="defaultTheme" 고정 + Client 즉시 정정
// 서버는 쿠키를 읽지 않고 무조건 defaultTheme으로 렌더한다.
// 클라이언트 인라인 스크립트가 localStorage/쿠키 중 더 최신(?) 값을 읽어
// <html>에 덮어씌운다. FOUC를 테마 변경 초기화 시에만 감수하는 대신 가장 단순하다.
// prerender/정적 페이지에 최적.

import { siteConfig } from "@/web/site";
import "../styles/global.css";
import { buildClientThemeConfigJson, getMetaColor } from "@/lib/theme";

interface Props {
    title?: string;
    description?: string;
}

const { title = siteConfig.brand, description = siteConfig.description } =
    Astro.props;

const themeSetting = siteConfig.theme;
const fixedTheme = themeSetting.defaultTheme;
const metaColor = getMetaColor(fixedTheme);
const canonical = new URL(
    Astro.url.pathname,
    Astro.site ?? "https://example.com"
).href;
const clientThemeConfig = buildClientThemeConfigJson();
---

<!doctype html>
<html lang="ko" data-theme={fixedTheme} data-theme-source="fixed-default">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="theme-color" id="theme-color-meta" content={metaColor} />
        <link rel="canonical" href={canonical} />
        <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
        />
        <slot name="head" />
        {/* 클라이언트가 읽는 우선순위:
               1) localStorage[storageKey]
               2) document.cookie[cookieKey]
               3) defaultTheme
               시스템 다크는 이 방식에선 의도적으로 무시된다. */}
        <script
            is:inline
            define:vars={{ clientThemeConfigRaw: clientThemeConfig }}
        >
            (function () {
                try {
                    var cfg = JSON.parse(clientThemeConfigRaw);
                    var cookieValue = null;
                    var cookies = document.cookie.split(";");
                    for (var i = 0; i < cookies.length; i++) {
                        var part = cookies[i].trim().split("=");
                        if (part[0] === cfg.cookieKey) {
                            cookieValue = decodeURIComponent(part[1] || "");
                            break;
                        }
                    }
                    var stored =
                        localStorage.getItem(cfg.storageKey) || cookieValue;
                    var theme =
                        stored && cfg.themes.indexOf(stored) !== -1
                            ? stored
                            : cfg.defaultTheme;
                    document.documentElement.setAttribute(cfg.attribute, theme);
                    var meta = document.getElementById("theme-color-meta");
                    if (meta && cfg.metaColor[theme]) {
                        meta.setAttribute("content", cfg.metaColor[theme]);
                    }
                } catch (e) {
                    /* 무시 */
                }
            })();
        </script>
    </head>
    <body>
        <slot />
    </body>
</html>
