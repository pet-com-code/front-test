---
// src/layouts/LayoutC.astro
// [방식 C] SSR 쿠키 우선 + 시스템 다크 폴백 허용
// 방식 A와 동일하게 서버가 쿠키를 읽는다.
// 단, 쿠키/?theme= 가 없을 때 defaultTheme을 넣지 않고
// <html data-theme> 자체를 생략한다.
// 이렇게 하면 global.css의
//   @media (prefers-color-scheme: dark) { :root:not([data-theme]) { ... } }
// 가 발동해 OS 다크 사용자에게 다크를 보여준다.
// site.ts의 useSystemPreference=true 일 때 의도한 동작.

import { siteConfig } from "@/web/site";
import "../styles/global.css";
import {
    buildClientThemeConfigJson,
    resolveSsrTheme,
    getMetaColor,
    type Theme
} from "@/lib/theme";

interface Props {
    title?: string;
    description?: string;
}

const { title = siteConfig.brand, description = siteConfig.description } =
    Astro.props;

const themeSetting = siteConfig.theme;
const cookieValue = Astro.cookies.get(themeSetting.cookieKey)?.value;
const queryValue = Astro.url.searchParams.get("theme");
const resolved = resolveSsrTheme({
    cookie: cookieValue,
    query: queryValue,
    allowSystemFallback: true
});

const serverThemeForMeta: Theme = resolved.theme ?? themeSetting.defaultTheme;
const metaColor = getMetaColor(serverThemeForMeta);
const canonical = new URL(
    Astro.url.pathname,
    Astro.site ?? "https://example.com"
).href;
const clientThemeConfig = buildClientThemeConfigJson();
const hasAttr = resolved.hasAttribute;
---

<!doctype html>
<html
    lang="ko"
    data-theme={hasAttr ? resolved.theme : undefined}
    data-theme-source={resolved.source}
>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="theme-color" id="theme-color-meta" content={metaColor} />
        <link rel="canonical" href={canonical} />
        <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
        />
        <slot name="head" />
        {/* 클라이언트: 저장값이 없을 때만 시스템 다크를 보고 data-theme를 생략한다.
               저장값이 있으면 서버 완성값과 동일하게 맞춘다. */}
        <script
            is:inline
            define:vars={{ clientThemeConfigRaw: clientThemeConfig }}
        >
            (function () {
                try {
                    var cfg = JSON.parse(clientThemeConfigRaw);
                    var cookieValue = null;
                    var cookies = document.cookie.split(";");
                    for (var i = 0; i < cookies.length; i++) {
                        var part = cookies[i].trim().split("=");
                        if (part[0] === cfg.cookieKey) {
                            cookieValue = decodeURIComponent(part[1] || "");
                            break;
                        }
                    }
                    var stored =
                        localStorage.getItem(cfg.storageKey) || cookieValue;
                    if (stored && cfg.themes.indexOf(stored) !== -1) {
                        document.documentElement.setAttribute(
                            cfg.attribute,
                            stored
                        );
                        localStorage.setItem(cfg.storageKey, stored);
                        document.cookie =
                            cfg.cookieKey +
                            "=" +
                            stored +
                            "; path=/; max-age=31536000; SameSite=Lax";
                        var meta = document.getElementById("theme-color-meta");
                        if (meta && cfg.metaColor[stored]) {
                            meta.setAttribute("content", cfg.metaColor[stored]);
                        }
                    } else if (
                        !stored &&
                        cfg.useSystemPreference &&
                        window.matchMedia("(prefers-color-scheme: dark)")
                            .matches
                    ) {
                        document.documentElement.removeAttribute(cfg.attribute);
                    }
                } catch (e) {
                    /* 무시 */
                }
            })();
        </script>
    </head>
    <body>
        <slot />
    </body>
</html>
