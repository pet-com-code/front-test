---
// https://front-test.pet-com-code.workers.dev
// https://www.youtube.com/watch?v=rz7suBIPC9I 글씨 써지는 효과
import { Image } from "astro:assets";
import Girl from "@/assets/img/coffee-700.png";
import GirlOld from "@/assets/img/coffee-700-old.png";
---

<html lang="ko">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>공사중</title>
    </head>
    <body>
        <div class="container">
            <!-- 첫 번째 div: 너비 700px -->
            <div class="center-page">
                <Image
                    class="img-wrapper base-img"
                    src={Girl}
                    alt="펫줍.닷컴"
                    width={700}
                />
                <Image
                    class="img-wrapper fade-img"
                    src={GirlOld}
                    alt="펫줍.닷컴"
                    width={700}
                />
            </div>

            <!-- 두 번째 div: 너비 1000px -->
            <div class="second-box">
                <img
                    src="/images/nun-saram-mini.gif"
                    alt="움직이는 이미지"
                    class="moving-img"
                />
            </div>
        </div>
    </body>
</html>

<script>
    document.addEventListener("contextmenu", (e) => {
        e.preventDefault();
    });
</script>

<style>
    /* 브라우저 기본 여백 제거 */
    :global(body) {
        margin: 0;
    }

    /* 전체 영역: 요소를 수직(column)으로 쌓고 화면 정중앙 배치 */
    .container {
        display: flex;
        flex-direction: column; /* 자식 요소들을 위아래 수직으로 배치 */
        justify-content: center; /* 세로 방향 중앙 정렬 */
        align-items: center; /* 가로 방향 중앙 정렬 */
        gap: 2rem; /* 두 div 사이의 위아래 간격 (필요에 따라 조절) */
        min-height: 100vh; /* 화면 전체 높이 확보 */
        padding: 1rem; /* 모바일 등 좁은 화면 양옆 여백 */
        box-sizing: border-box;
    }

    /* 첫 번째 div (700px) */
    .center-page {
        width: 100%;
        max-width: 700px; /* 최대 너비 700px 고정 */
        position: relative; /* 자식 래퍼들을 겹치기 위한 기준점 */
    }

    /* 두 이미지 래퍼를 정확히 같은 크기로 맞춤 */
    .img-wrapper {
        width: 100%;
    }

    /* 내부 img 태그 크기 강제 일치 */
    .img-wrapper :global(img) {
        width: 100%;
        height: auto;
        display: block;
        user-select: none;
        -webkit-user-drag: none;
    }

    /* 위에 겹쳐지는 GirlOld 래퍼 설정 */
    .fade-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        animation: fadeInOld 18s ease-in-out 2s forwards;
    }

    /* 만약 두 원본 이미지의 세로 비율이 미세하게 다를 경우 삐져나오지 않게 맞춤 */
    .fade-img :global(img) {
        height: 100%;
        object-fit: cover;
    }

    @keyframes fadeInOld {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    /* 두 번째 div (1000px) */
    .second-box {
        width: 100%;
        max-width: 1000px;
        height: 136px;
        position: relative;
        overflow: hidden;
    }

    .moving-img {
        width: 250px;
        height: 136px;
        position: absolute;
        left: 0;
        top: 0;
        animation: moveRight 20s linear forwards;
    }

    @keyframes moveRight {
        from {
            left: 0;
            transform: translateX(0);
        }
        to {
            left: 100%;
            transform: translateX(-100%);
        }
    }

    /* 아래에 깔리는 첫 번째 이미지 (Girl)가 서서히 투명해짐 */
    .base-img {
        animation: fadeOutYoung 18s ease-in-out 2s forwards;
    }

    @keyframes fadeOutYoung {
        from {
            opacity: 1; /* 처음엔 100% 보임 (불투명) */
        }
        to {
            opacity: 0; /* 끝날 땐 완전히 투명해짐 */
        }
    }

    /* 위에 겹쳐지는 두 번째 이미지 (GirlOld)가 서서히 나타남 */
    .fade-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0; /* 처음엔 완전히 투명 */
        animation: fadeInOld 18s ease-in-out 2s forwards;
    }

    @keyframes fadeInOld {
        from {
            opacity: 0;
        }
        to {
            opacity: 1; /* 끝날 땐 100% 보임 (불투명) */
        }
    }
</style>
