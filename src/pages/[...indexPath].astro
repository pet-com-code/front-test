---
// https://front-test.pet-com-code.workers.dev
import { Image } from "astro:assets";
import Logo from "@/assets/img/coffee-700.png";
---

<html lang="ko">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>공사중</title>
    </head>
    <body>
        <div class="container">
            <!-- 첫 번째 div: 너비 700px -->
            <div class="center-page">
                <Image class="box" src={Logo} alt="펫줍.닷컴" width={700} />
            </div>

            <!-- 두 번째 div: 너비 1000px -->
            <div class="second-box">
                <img
                    src="/images/nun-saram-mini.gif"
                    alt="움직이는 이미지"
                    class="moving-img"
                />
            </div>
        </div>
    </body>
</html>

<script>
    document.addEventListener("contextmenu", (e) => {
        e.preventDefault();
    });
</script>

<style>
    /* 브라우저 기본 여백 제거 */
    :global(body) {
        margin: 0;
    }

    /* 전체 영역: 요소를 수직(column)으로 쌓고 화면 정중앙 배치 */
    .container {
        display: flex;
        flex-direction: column; /* 자식 요소들을 위아래 수직으로 배치 */
        justify-content: center; /* 세로 방향 중앙 정렬 */
        align-items: center; /* 가로 방향 중앙 정렬 */
        gap: 2rem; /* 두 div 사이의 위아래 간격 (필요에 따라 조절) */
        min-height: 100vh; /* 화면 전체 높이 확보 */
        padding: 1rem; /* 모바일 등 좁은 화면 양옆 여백 */
        box-sizing: border-box;
    }

    /* 첫 번째 div (700px) */
    .center-page {
        width: 100%;
        max-width: 700px; /* 최대 너비 700px 고정 */
        display: flex;
        justify-content: center;
    }

    /* 두 번째 div (1000px) */
    .second-box {
        width: 100%;
        max-width: 1000px; /* 최대 너비 1000px 고정 */
        height: 136px;
        /* border: 1px solid #ccc;  영역 확인용 테두리 (필요 없으면 삭제) */
        position: relative;
        overflow: hidden; /* 밖으로 나가는 부분 숨김 */
    }

    /* 로고 이미지 반응형 처리 */
    .box {
        max-width: 100%;
        height: auto;
        display: block;
        user-select: none; /* 마우스 드래그 방지 */
        -webkit-user-drag: none;
    }
    .moving-img {
        width: 250px;
        height: 136px;
        position: absolute;
        left: 0;
        top: 0;
        /* 5s 부분을 원하는 초 단위로 변경하세요 (예: 0.5s, 2s, 5s) */
        animation: moveRight 20s linear forwards;
    }

    @keyframes moveRight {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(750px); /* 1000px - 250px */
        }
    }
</style>
